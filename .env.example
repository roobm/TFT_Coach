# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Local Supabase values are printed by `supabase start` (and `supabase status`).

# Supabase (local defaults)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# LM Studio (local, OpenAI-compatible API). Use localhost when running outside Docker.
LM_STUDIO_URL=http://host.docker.internal:1234/v1

# Embedding model used by the seeder. Must output the schema's vector dimension (1536).
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
EMBEDDING_DIM=1536

# Chat model used for match-history insights (any model loaded in LM Studio).
CHAT_MODEL=local-model

# Riot
RIOT_API_KEY=RGAPI-...
# Regional routing host for Account-V1 / TFT-Match-V1 (americas | asia | europe).
RIOT_REGION=europe
# Platform routing host for TFT-League-V1 ranked data (euw1 | na1 | kr | ...).
RIOT_PLATFORM=euw1
LIVE_CLIENT_URL=http://host.docker.internal:2999

# Frontend dev origin allowed by the API CORS policy.
FRONTEND_ORIGIN=http://localhost:5173
